# ─── Database ────────────────────────────────────────────────────────────────
# XAMPP's MariaDB 10.4. Start it with: sudo /opt/lampp/lampp startmysql
# The socket form avoids TCP entirely; swap to host/port if you prefer.
DATABASE_URL="mysql://root@127.0.0.1:3306/bugtraker"
DATABASE_URL_TEST="mysql://root@127.0.0.1:3306/bugtraker_test"
DB_POOL_SIZE=10

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
# Comma-separated. :4200 is `ng serve`; same-origin behind XAMPP needs nothing.
CORS_ORIGINS="http://localhost:4200"

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-a-long-random-string-at-least-32-chars"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Keeps the login page's demo-user panel working and accepts any password for the
# eight seeded accounts (those with no password hash). Also gates /admin/import
# and /admin/reset. MUST be false outside local development.
DEMO_MODE=true

# ─── Storage ─────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_ROOT=./var/storage
ATTACHMENT_RETENTION_DAYS=7
PENDING_UPLOAD_MAX_FILES=50
PENDING_UPLOAD_MAX_BYTES=104857600

# ─── Ports / adapters ────────────────────────────────────────────────────────
# 'like' is the AUTHORITY on search semantics, not a fallback: the frontend matches
# substrings mid-word (searching "ogin" finds "Login"), which InnoDB FULLTEXT cannot do —
# it matches whole tokens. This server also runs innodb_ft_min_token_size=3 with stopwords
# on, so FULLTEXT would additionally drop short and common words. The ft_ indexes exist
# and are maintained; flip to 'fulltext' once my.cnf sets min_token_size=1 and
# innodb_ft_enable_stopword=OFF, and accept token-boundary matching.
SEARCH_DRIVER=like
CACHE_DRIVER=memory
QUEUE_DRIVER=in-process

# ─── Misc ────────────────────────────────────────────────────────────────────
UNDO_TTL_MS=120000
IMPORT_MAX_BYTES=67108864
# Fixed clock for a reproducible seed. Matches frontend issue-filter.spec.ts, so the
# assertions there (#7 -> id 7, web-2 -> id 2) hold against this database too.
SEED_NOW="2026-09-29T00:00:00.000Z"
SEED_PASSWORD="demo"
