{
  "name": "bt-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Bug Tracker API \u2014 NestJS + Drizzle + MariaDB",
  "license": "UNLICENSED",
  "packageManager": "npm@11.6.4",
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch -p tsconfig.build.json",
    "start:debug": "nest start --debug --watch -p tsconfig.build.json",
    "sync:shared": "node scripts/sync-shared.mjs",
    "sync:shared:check": "node scripts/sync-shared.mjs --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:check": "tsx scripts/check-integrity.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "npm run build && vitest run --project e2e",
    "test:watch": "vitest --project unit",
    "lint": "eslint src scripts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:all": "npm run sync:shared:check && npm run typecheck && npm run test:unit && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.5",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.12",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.0.7",
    "@node-rs/argon2": "^2.0.2",
    "@tiptap/core": "^3.31.3",
    "archiver": "^7.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.2.1",
    "file-type": "^20.4.1",
    "mysql2": "^3.12.0",
    "nestjs-pino": "^4.3.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.0.12",
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.22.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^4.0.8"
  }
}
